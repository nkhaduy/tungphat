  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.trustindex.io https://*.trustindex.io https://www.googletagmanager.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://*.trustindex.io; img-src 'self' data: blob: https://*.trustindex.io https://*.googleusercontent.com https://www.googletagmanager.com; font-src 'self' data: https://*.trustindex.io; connect-src 'self' https://cms.mdftungphat.com https://*.trustindex.io https://www.google-analytics.com https://region1.google-analytics.com https://challenges.cloudflare.com; frame-src https://www.google.com https://challenges.cloudflare.com; media-src 'self' https://cms.mdftungphat.com https://media.mdftungphat.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self' https://cms.mdftungphat.com https://tungphat-cms.pages.dev https://preview.tungphat-cms.pages.dev http://127.0.0.1:4174 http://localhost:4174; form-action 'self'; upgrade-insecure-requests


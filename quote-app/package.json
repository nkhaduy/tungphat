{
  "name": "@tungphat/quote-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run d1:migrate:local && vite",
    "build": "vite build && node scripts/clean-build-output.mjs",
    "build:pages": "npm run build && wrangler deploy src/worker/index.ts --dry-run --config wrangler.worker.jsonc --outdir dist/pages-worker --no-bundle=false && node scripts/prepare-pages.mjs",
    "preview": "wrangler dev --config wrangler.worker.jsonc",
    "preview:pages": "npm run build:pages && wrangler pages dev dist/client",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "cf:typegen": "wrangler types worker-configuration.d.ts --config wrangler.worker.jsonc --env-file .dev.vars.example --env-interface QuoteAppEnv --include-runtime false --strict-vars false",
    "d1:migrate:local": "wrangler d1 migrations apply tung-phat-quotes --local",
    "d1:migrate:remote": "wrangler d1 migrations apply tung-phat-quotes --remote",
    "deploy:pages": "npm run build:pages && wrangler pages deploy dist/client --project-name tungphat-quotes",
    "admin:create": "node scripts/create-admin.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "hono": "^4.10.4",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.15.2",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.5",
    "jsqr": "^1.4.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.1.12",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  },
  "engines": {
    "node": ">=20.19 <27"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}

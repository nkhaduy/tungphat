{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "./cloudflare-cms/worker-configuration.d.ts"]
  },
  "include": [
    "functions/**/*.ts",
    "cloudflare-cms/worker-configuration.d.ts",
    "cloudflare-cms/src/**/*.ts",
    "workers/analytics-maintenance/src/**/*.ts"
  ]
}

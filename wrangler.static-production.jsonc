{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Prepared for review only: no routes, custom domain or workers.dev trigger.
  "name": "tungphat-static-assets",
  "main": "workers/static-production.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "gotungphat.com", "custom_domain": true },
    { "pattern": "www.gotungphat.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./.wrangler/workers-production-assets",
    "binding": "ASSETS",
    "run_worker_first": ["/catalog/*", "/api/analytics/track"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tungphat-static-assets",
  "main": "workers/static-production.mjs",
  "account_id": "b9ae472cee29c5729ee90ccbb3533f33",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "gotungphat.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ANALYTICS_ORIGIN": "https://cms.mdftungphat.com",
    "MEDIA_ORIGIN": "https://cms.mdftungphat.com"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/catalog/*",
      "/api/analytics/track"
    ]
  }
}

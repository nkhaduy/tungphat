{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tungphat-analytics-maintenance",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tung-phat-leads",
      "database_id": "1af7dea0-3168-446d-be77-828c57d1e370"
    }
  ],
  "triggers": {
    "crons": ["15 18 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "env": {
    "preview": {
      "name": "tungphat-analytics-maintenance-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tung-phat-leads-preview",
          "database_id": "9ef568b8-dc45-4315-b18d-b98518790ed6"
        }
      ],
      "triggers": {
        "crons": []
      }
    }
  }
}

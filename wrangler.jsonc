{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tung-phat-local-test",
  "pages_build_output_dir": "./out",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tung-phat-leads-preview",
      "database_id": "9ef568b8-dc45-4315-b18d-b98518790ed6",
      "migrations_dir": "./cloudflare-cms/migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "preview",
    "CORS_ALLOWED_ORIGINS": "http://127.0.0.1:4173,http://localhost:4173",
    "CORS_ALLOWED_ORIGIN_SUFFIXES": ".vercel.app",
    "TURNSTILE_ALLOWED_HOSTNAMES": "localhost,127.0.0.1",
    "TURNSTILE_ALLOWED_HOSTNAME_SUFFIXES": ".vercel.app",
    "TURNSTILE_EXPECTED_ACTION": "tung-phat-lead",
    "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA"
  }
}

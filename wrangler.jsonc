{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tung-phat",
  "pages_build_output_dir": "./out",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tung-phat-leads",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "tung-phat-media"
    }
  ],
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tung-phat-leads-preview",
          "database_id": "11111111-1111-1111-1111-111111111111",
          "migrations_dir": "./migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "tung-phat-media-preview"
        }
      ]
    }
  }
}

# Public build-time values. The Turnstile site key is safe to expose.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
NEXT_PUBLIC_FORMS_API_BASE=https://cms.mdftungphat.com
# Tùy chọn: URL video private R2 qua CMS Worker; để trống sẽ hiện ảnh poster.
# Production: https://cms.mdftungphat.com/media/videos/legacy/0619.mp4
NEXT_PUBLIC_PROCESS_VIDEO_URL=
# Chỉ bật sau khi xác minh widget hiển thị review thật của đúng doanh nghiệp.
NEXT_PUBLIC_TRUSTINDEX_WIDGET_ID=
NEXT_PUBLIC_REVIEWS_PROVIDER=

# Keep these only in .dev.vars / Cloudflare secrets, never in this file with real values.
# TURNSTILE_SECRET_KEY=
# IP_HASH_SALT= # Chuỗi ngẫu nhiên >= 32 ký tự; đặt bằng secret, không commit.
# GITHUB_OAUTH_ID=
# GITHUB_OAUTH_SECRET=
# OAUTH_STATE_SECRET=

# Public build-time values. The Turnstile site key is safe to expose.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
# Preview: Public Development URL của tung-phat-media-preview. Production tương lai: https://media.mdftungphat.com
NEXT_PUBLIC_MEDIA_BASE_URL=https://pub-REPLACE.r2.dev
# Chỉ bật sau khi xác minh widget hiển thị review thật của đúng doanh nghiệp.
NEXT_PUBLIC_TRUSTINDEX_WIDGET_ID=
NEXT_PUBLIC_REVIEWS_PROVIDER=

# Keep these only in .dev.vars / Cloudflare secrets, never in this file with real values.
# TURNSTILE_SECRET_KEY=
# GITHUB_OAUTH_ID=
# GITHUB_OAUTH_SECRET=
# OAUTH_STATE_SECRET=
# MEDIA_ADMIN_EMAILS=
# MEDIA_LOCAL_DEV_BYPASS=1 # Chỉ .dev.vars trên localhost; không cấu hình public.

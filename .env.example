# Public build-time values. The Turnstile site key is safe to expose.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
NEXT_PUBLIC_TRUSTINDEX_WIDGET_ID=a4fdfb476ed7886bec16ab20482
NEXT_PUBLIC_REVIEWS_PROVIDER=trustindex


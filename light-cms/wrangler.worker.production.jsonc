{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tungphat-light-cms-api-production",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "ENVIRONMENT": "production",
    "SERVICE_NAME": "tungphat-light-cms-api-production",
    "ALLOWED_ORIGINS": "https://cms.mdftungphat.com",
    "BAOGIA_SSO_ISSUER": "https://baogia.mdftungphat.com",
    "BAOGIA_SSO_AUD": "tungphat-light-cms",
    "BAOGIA_SSO_KEY_ID": "baogia-cms-2026-08"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "tungphat-light-cms-production", "database_id": "c46b5fa3-6db7-4de4-b797-99fc07158506", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "tungphat-light-media-production" }
  ]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tungphat-light-cms-api-production",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "ENVIRONMENT": "production",
    "SERVICE_NAME": "tungphat-light-cms-api-production",
    "ALLOWED_ORIGINS": "https://tungphat-light-cms-production.pages.dev,https://cms.mdftungphat.com",
    "ACCESS_ISSUER": "https://broken-river-6fe3.cloudflareaccess.com",
    "ACCESS_AUD": "425f831d635f338ccd1ae478e177399fad5e572170c08c52955fa19ec8706d51",
    "COOKIE_SECURE": "true"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "tungphat-light-cms-production", "database_id": "c46b5fa3-6db7-4de4-b797-99fc07158506", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "tungphat-light-media-production" }
  ]
}

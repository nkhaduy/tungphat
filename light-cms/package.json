{
  "name": "@tungphat/light-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:production": "VITE_LIGHT_CMS_ENV=production vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "worker:dev": "wrangler dev --config wrangler.worker.jsonc --local",
    "worker:dry-run": "wrangler deploy --dry-run --config wrangler.worker.jsonc",
    "worker:production:dry-run": "wrangler deploy --dry-run --config wrangler.worker.production.jsonc",
    "worker:production:deploy": "wrangler deploy --config wrangler.worker.production.jsonc",
    "runtime:local-smoke": "tsx scripts/local-runtime-smoke.ts",
    "benchmark:access-local": "tsx scripts/benchmark-access-local.ts",
    "scan:access-bundle": "tsx scripts/scan-access-bundle.ts dist .wrangler/access-bundle",
    "pages:dev": "wrangler pages dev dist --config wrangler.pages.jsonc",
    "pages:production:deploy": "cd deploy/production-pages && wrangler pages deploy ../../dist --project-name tungphat-light-cms-production --branch main --commit-dirty=true",
    "d1:local": "wrangler d1 migrations apply tungphat-light-cms-20260805-0855-staging --local --config wrangler.worker.jsonc"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/workers-types": "^5.20260718.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.5",
    "globals": "^17.9.0",
    "jsdom": "^27.0.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "wrangler": "4.115.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "undici": "7.29.0"
  },
  "engines": {
    "node": ">=20.19 <27"
  }
}

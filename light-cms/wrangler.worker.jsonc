{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tungphat-light-cms-api-20260805-0855-staging",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-18",
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "ENVIRONMENT": "staging",
    "SERVICE_NAME": "tungphat-light-cms-api-20260805-0855-staging",
    "ALLOWED_ORIGINS": "https://tungphat-light-cms-20260805-0855-staging.pages.dev",
    "BAOGIA_SSO_ISSUER": "https://baogia.mdftungphat.com",
    "BAOGIA_SSO_AUD": "tungphat-light-cms",
    "BAOGIA_SSO_KEY_ID": "baogia-cms-2026-08"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "tungphat-light-cms-20260805-0855-staging", "database_id": "746333af-3306-4567-9f56-636c6fb1966b", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "tungphat-light-media-20260805-0855-staging" }
  ],
  "triggers": { "crons": ["17 3 * * *"] }
}

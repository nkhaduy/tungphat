{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tungphat-light-cms-production",
  "pages_build_output_dir": "../../dist",
  "compatibility_date": "2026-08-08",
  "vars": {
    "LEGACY_CMS_ORIGIN": "https://d9e520d2.tungphat-cms.pages.dev",
    "LIGHT_CMS_GATEWAY": "pages-production"
  },
  "services": [
    { "binding": "LIGHT_CMS_API", "service": "tungphat-light-cms-api-production" }
  ]
}

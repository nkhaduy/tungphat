{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tungphat-light-cms-production",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-10-01",
  "r2_buckets": [{ "binding": "R2", "bucket_name": "tung-phat-media" }],
  "env": {
    "preview": {
      "vars": { "ARCHIVE_FIRST": "true" },
      "r2_buckets": [{ "binding": "R2", "bucket_name": "tung-phat-media" }]
    }
  }
}

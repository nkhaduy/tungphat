{
  "name": "@tungphat/payload-cms",
  "version": "1.0.0",
  "description": "Payload CMS doc lap cho he sinh thai Tung Phat tren Cloudflare Workers, D1 va R2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy:production": "npm run build:cloudflare && wrangler deploy --env production",
    "deploy:verified": "npm run verify && npm run deploy:production && npm run deploy:gateway",
    "deploy:gateway": "wrangler pages deploy gateway --project-name tungphat-light-cms-production --branch main",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:clean": "node scripts/clean-local-build.mjs && npm run dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "npm run generate:types:cloudflare && npm run generate:types:payload",
    "generate:types:cloudflare": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:types:payload": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "integration": "npm run migrate:local && vitest run --config ./vitest.config.mts tests/int",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint . --max-warnings=0",
    "sync:suppliers:production": "cross-env DEPLOY_ENV=production tsx scripts/sync-suppliers-production.ts",
    "migrate:local": "cross-env PAYLOAD_SECRET=local-development-only-change-me payload migrate",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --env=$CLOUDFLARE_ENV",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "npm run test:int",
    "test:e2e": "cross-env PAYLOAD_SECRET=local-development-only-change-me CMS_ENVIRONMENT=local NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "npm run integration",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run integration && npm run build:cloudflare && wrangler deploy --env production --dry-run"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@payloadcms/db-d1-sqlite": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-r2": "3.88.0",
    "@payloadcms/translations": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.2.11",
    "payload": "3.88.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@node-minify/core": "8.0.6",
    "@node-minify/terser": "8.0.6",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.11",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "npm": ">=10"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.24",
      "sharp": "0.35.3"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "cloudflare": {
    "bindings": {
      "PAYLOAD_SECRET": {
        "description": "Generate a random string using `openssl rand -hex 32`"
      }
    }
  }
}

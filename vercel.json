{
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://cms.mdftungphat.com",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "destination": "https://cms.mdftungphat.com",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.mdftungphat.com" }],
      "destination": "https://mdftungphat.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    }
  ]
}

{
  "redirects": [
    {
      "source": "/gia-cong-cnc-go",
      "destination": "/cat-cnc-go/",
      "permanent": true
    },
    {
      "source": "/gia-cong-cnc-go/",
      "destination": "/cat-cnc-go/",
      "permanent": true
    },
    {
      "source": "/cnc-mdf",
      "destination": "/gia-cong-cnc-mdf/",
      "permanent": true
    },
    {
      "source": "/cnc-mdf/",
      "destination": "/gia-cong-cnc-mdf/",
      "permanent": true
    },
    {
      "source": "/admin/analytics",
      "destination": "https://cms.mdftungphat.com/?view=analytics",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "https://cms.mdftungphat.com",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "destination": "https://cms.mdftungphat.com",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.mdftungphat.com" }],
      "destination": "https://mdftungphat.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.trustindex.io https://*.trustindex.io https://www.googletagmanager.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://*.trustindex.io; img-src 'self' data: blob: https://*.trustindex.io https://www.googletagmanager.com; font-src 'self' data: https://*.trustindex.io; connect-src 'self' https://cms.mdftungphat.com https://*.trustindex.io https://www.google-analytics.com https://region1.google-analytics.com https://challenges.cloudflare.com; frame-src https://www.google.com https://challenges.cloudflare.com; media-src 'self' https://cms.mdftungphat.com https://media.mdftungphat.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self' https://cms.mdftungphat.com https://tungphat-cms.pages.dev https://preview.tungphat-cms.pages.dev http://127.0.0.1:4174 http://localhost:4174; form-action 'self'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/(images|wood|partners)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/cms-preview/",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "Referrer-Policy", "value": "strict-origin" }
      ]
    },
    {
      "source": "/cms-preview/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "Referrer-Policy", "value": "strict-origin" }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    }
  ]
}

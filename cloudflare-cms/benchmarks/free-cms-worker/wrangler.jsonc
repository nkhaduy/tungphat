{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tungphat-light-cms-benchmark",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tungphat-light-cms-benchmark",
      "database_id": "a433800e-dfaa-4ae8-b584-b2afc7ebfb87"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "tungphat-light-cms-benchmark"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}

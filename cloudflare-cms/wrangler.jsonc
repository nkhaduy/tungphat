{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tungphat-light-cms-production",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tung-phat-leads",
      "database_id": "1af7dea0-3168-446d-be77-828c57d1e370",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "tung-phat-media"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "CORS_ALLOWED_ORIGINS": "https://mdftungphat.com,https://www.mdftungphat.com",
    "CORS_ALLOWED_ORIGIN_SUFFIXES": "",
    "TURNSTILE_ALLOWED_HOSTNAMES": "mdftungphat.com,www.mdftungphat.com",
    "TURNSTILE_ALLOWED_HOSTNAME_SUFFIXES": "",
    "TURNSTILE_EXPECTED_ACTION": "tung-phat-lead",
    "CMS_ALLOWED_ORIGINS": "https://cms.mdftungphat.com,https://tungphat-light-cms-production.pages.dev",
    "CMS_SITE_IDS": "cms.mdftungphat.com,tungphat-light-cms-production.pages.dev",
    "OAUTH_CALLBACK_URL": "https://cms.mdftungphat.com/callback",
    "OAUTH_ALLOWED_EMAIL": "nkhaduy@gmail.com",
    "GITHUB_REPO_PRIVATE": "0",
    "GBP_GOOGLE_PROJECT_ID": "stable-inn-503413-e2",
    "GBP_GOOGLE_REDIRECT_URI": "https://cms.mdftungphat.com/api/gbp/oauth/callback"
  },
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tung-phat-leads-preview",
          "database_id": "9ef568b8-dc45-4315-b18d-b98518790ed6",
          "migrations_dir": "./migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "tung-phat-media-preview"
        }
      ],
      "vars": {
        "ENVIRONMENT": "preview",
        "CORS_ALLOWED_ORIGINS": "https://mdftungphat.com,https://www.mdftungphat.com,http://127.0.0.1:4173,http://localhost:4173",
        "CORS_ALLOWED_ORIGIN_SUFFIXES": ".vercel.app",
        "TURNSTILE_ALLOWED_HOSTNAMES": "mdftungphat.com,www.mdftungphat.com,localhost,127.0.0.1,preview.tungphat-cms.pages.dev",
        "TURNSTILE_ALLOWED_HOSTNAME_SUFFIXES": ".vercel.app",
        "TURNSTILE_EXPECTED_ACTION": "tung-phat-lead",
        "CMS_ALLOWED_ORIGINS": "https://preview.tungphat-cms.pages.dev",
        "CMS_SITE_IDS": "preview.tungphat-cms.pages.dev",
        "OAUTH_CALLBACK_URL": "https://preview.tungphat-cms.pages.dev/callback",
        "OAUTH_ALLOWED_EMAIL": "nkhaduy@gmail.com",
        "GITHUB_REPO_PRIVATE": "0",
        "GBP_GOOGLE_PROJECT_ID": "stable-inn-503413-e2",
        "GBP_GOOGLE_REDIRECT_URI": "https://preview.tungphat-cms.pages.dev/api/gbp/oauth/callback"
      }
    }
  }
}

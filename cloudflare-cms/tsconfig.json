{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "./worker-configuration.d.ts"]
  },
  "include": ["functions/**/*.ts", "src/**/*.ts", "tests/**/*.ts"]
}

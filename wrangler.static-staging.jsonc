{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tungphat-release-staging-20261123",
  "main": "workers/static-production.mjs",
  "account_id": "b9ae472cee29c5729ee90ccbb3533f33",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "RELEASE_STAGING": "true",
    "MEDIA_ORIGIN": "https://cms.mdftungphat.com"
  },
  "services": [
    {
      "binding": "ANALYTICS_SERVICE",
      "service": "tungphat-payload-cms-staging"
    }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tungphat-static-assets-preview",
  "main": "workers/static-preview.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "services": [
    { "binding": "STAGING_CMS", "service": "tungphat-payload-cms-staging" }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}

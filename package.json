{
  "name": "tung-phat-landing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:content && npm run images:check && node ./node_modules/next/dist/bin/next build",
    "postbuild": "node scripts/clean-empty-collection-routes.mjs && node scripts/clean-export-image-sources.mjs && node scripts/check-static-output.mjs && node scripts/check-sitemap-output.mjs",
    "start": "npx serve out",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.cloudflare.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --reporter=list",
    "test:e2e:cms": "playwright test --config=playwright.cms.config.ts",
    "test:e2e:light": "playwright test --config=playwright.light-cms.config.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:links": "node scripts/check-internal-links.mjs && node scripts/check-sitemap-output.mjs",
    "validate:cloudflare-config": "node cloudflare-cms/scripts/validate-cloudflare-config.mjs",
    "images:check": "node scripts/check-images.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "media:compress:video": "bash scripts/compress-video-for-web.sh",
    "content:migrate:legacy": "tsx scripts/migrate-legacy-content.ts",
    "cf:typegen": "wrangler types functions/cloudflare-env.d.ts --config wrangler.jsonc --env-file .dev.vars.example --env-interface CloudflareEnv --include-runtime false --strict-vars false && npm --prefix cloudflare-cms run cf:typegen",
    "cf:preview": "npm run validate:cloudflare-config && npm run build && wrangler pages dev out --env-file .dev.vars.example",
    "cf:test-server": "wrangler pages dev out --binding IP_HASH_SALT=ci-only-not-a-production-secret-00000001 --binding ANALYTICS_HASH_SALT=ci-only-analytics-not-production-0000001 --persist-to cloudflare-cms/.wrangler/state --port 4173",
    "d1:migrate:local": "wrangler d1 migrations apply tung-phat-leads-preview --local --config cloudflare-cms/wrangler.jsonc --env preview",
    "d1:migrate:preview": "npm run validate:cloudflare-config && npm --prefix cloudflare-cms run d1:migrate:preview",
    "d1:migrate:remote": "npm run validate:cloudflare-config && npm --prefix cloudflare-cms run d1:migrate:production",
    "d1:backup": "npm run validate:cloudflare-config && npm --prefix cloudflare-cms run d1:backup",
    "cms:dev": "npm --prefix cloudflare-cms run dev",
    "cms:dry-run": "npm --prefix cloudflare-cms run cms:dry-run",
    "cms:deploy": "npm --prefix cloudflare-cms run deploy:production",
    "analytics:maintenance:dry-run": "wrangler deploy --dry-run --env=\"\" --config workers/analytics-maintenance/wrangler.jsonc",
    "analytics:maintenance:preview": "wrangler deploy --env preview --config workers/analytics-maintenance/wrangler.jsonc",
    "analytics:maintenance:deploy": "wrangler deploy --env=\"\" --config workers/analytics-maintenance/wrangler.jsonc"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "framer-motion": "^12.42.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.24.0",
    "next": "15.5.22",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/workers-types": "^5.20260718.1",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "postcss": "^8.5.25",
    "prettier": "^3.9.5",
    "serve": "^14.2.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=20.19 <27"
  },
  "overrides": {
    "@eslint/eslintrc": {
      "js-yaml": "4.3.1"
    },
    "gray-matter": {
      "js-yaml": "3.15.1"
    },
    "nanoid": "3.3.17",
    "postcss": "$postcss",
    "sharp": "$sharp",
    "undici": "7.29.0"
  }
}

{
  "name": "tung-phat-landing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/prepare-indexnow-key.mjs && node scripts/generate-material-reference.mjs && node scripts/generate-cnc-preflight.mjs",
    "build": "npm run validate:content && npm run images:check && node ./node_modules/next/dist/bin/next build",
    "postbuild": "node scripts/clean-empty-collection-routes.mjs && node scripts/clean-export-image-sources.mjs && node scripts/check-static-output.mjs && node scripts/check-cloudflare-pages-capacity.mjs && JS_BUDGET_OUTPUT=reports/phase6-js-budgets.json tsx scripts/check-js-budgets.ts && node scripts/check-sitemap-output.mjs && node scripts/check-metadata-output.mjs && tsx scripts/audit-seo-output.ts && CATALOGUE_QUALITY_OUTPUT=reports/phase6-catalogue-quality.json tsx scripts/audit-catalogue-quality.ts && node scripts/validate-structured-data.mjs",
    "start": "npx serve out",
    "lint": "eslint app components lib scripts tests e2e functions workers eslint.config.mjs next.config.mjs postcss.config.mjs vitest.config.ts playwright.config.ts playwright.cms.config.ts --max-warnings=0 && npm --prefix cloudflare-cms run lint",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.cloudflare.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA NEXT_PUBLIC_ANALYTICS_TEST_MODE=1 npm run build && playwright test --reporter=list",
    "check:js-budgets": "tsx scripts/check-js-budgets.ts",
    "audit:catalogue-quality": "tsx scripts/audit-catalogue-quality.ts",
    "test:e2e:cms": "playwright test --config=playwright.cms.config.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:links": "node scripts/check-internal-links.mjs && node scripts/check-sitemap-output.mjs",
    "audit:seo": "tsx scripts/audit-seo-output.ts",
    "validate:schema": "node scripts/validate-structured-data.mjs",
    "indexnow:prepare-key": "node scripts/prepare-indexnow-key.mjs",
    "indexnow:submit": "tsx scripts/submit-indexnow.mjs",
    "generate:query-map": "tsx scripts/generate-query-url-map.ts",
    "audit:production": "tsx scripts/audit-production.ts",
    "benchmark:search": "tsx scripts/benchmark-search-visibility.ts",
    "monitor:search": "tsx scripts/monitor-search.ts",
    "observe:indexation": "tsx scripts/observe-indexation.ts",
    "entity:graph": "tsx scripts/build-entity-graph.ts",
    "audit:internal-graph": "tsx scripts/audit-internal-link-graph.ts",
    "validate:provenance": "tsx scripts/validate-material-provenance.ts",
    "validate:legacy-redirects": "node scripts/check-legacy-redirects.mjs",
    "validate:homepage-images": "node scripts/check-homepage-images.mjs",
    "validate:thanh-thuy": "node scripts/check-thanh-thuy-catalog.mjs",
    "validate:cloudflare-config": "node cloudflare-cms/scripts/validate-cloudflare-config.mjs",
    "images:check": "node scripts/check-images.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "media:compress:video": "bash scripts/compress-video-for-web.sh",
    "media:inventory": "tsx scripts/media/inventory.ts",
    "media:sync": "tsx scripts/media/sync-cli.ts",
    "media:cleanup": "tsx scripts/media/cleanup.ts",
    "media:publish": "npm run media:inventory && npm run media:sync && npm run media:cleanup",
    "media:check-git": "tsx scripts/media/check-git.ts",
    "catalog:thanh-thuy:discover": "tsx scripts/thanh-thuy/discover.ts",
    "catalog:thanh-thuy:discover:full": "tsx scripts/thanh-thuy/discover-full.ts",
    "catalog:thanh-thuy:audit:product-urls": "tsx scripts/thanh-thuy/audit-product-urls.ts",
    "catalog:thanh-thuy:crawl": "tsx scripts/thanh-thuy/crawl.ts",
    "catalog:thanh-thuy:crawl:full": "tsx scripts/thanh-thuy/crawl.ts",
    "catalog:thanh-thuy:import": "tsx scripts/thanh-thuy/import.ts && npm run media:publish",
    "catalog:thanh-thuy:import:full": "tsx scripts/thanh-thuy/run-full.ts && npm run media:publish",
    "catalog:thanh-thuy:validate": "tsx scripts/thanh-thuy/validate.ts",
    "catalog:thanh-thuy:validate:full": "tsx scripts/thanh-thuy/validate.ts && tsx scripts/thanh-thuy/full.ts --validate-only",
    "catalog:thanh-thuy:audit-duplication": "tsx scripts/thanh-thuy/duplication-audit.ts",
    "catalog:ba-thanh:discover": "tsx scripts/ba-thanh/discover.ts",
    "catalog:ba-thanh:discover:full": "tsx scripts/ba-thanh/discover-full.ts",
    "catalog:ba-thanh:crawl": "tsx scripts/ba-thanh/crawl.ts",
    "catalog:ba-thanh:crawl:full": "tsx scripts/ba-thanh/crawl-full.ts",
    "catalog:ba-thanh:import": "tsx scripts/ba-thanh/import.ts && npm run media:publish",
    "catalog:ba-thanh:import:full": "tsx scripts/ba-thanh/full.ts && npm run media:publish",
    "catalog:ba-thanh:validate": "tsx scripts/ba-thanh/validate.ts",
    "catalog:ba-thanh:validate:full": "tsx scripts/ba-thanh/validate.ts && tsx scripts/ba-thanh/full.ts --validate-only",
    "catalog:ba-thanh:audit": "tsx scripts/ba-thanh/duplication-audit.ts",
    "catalog:ba-thanh:color-media:discover": "tsx scripts/ba-thanh/media-discover.ts",
    "catalog:ba-thanh:color-media:download": "tsx scripts/ba-thanh/media-download.ts && npm run media:publish",
    "catalog:ba-thanh:color-media:validate": "tsx scripts/ba-thanh/media-validate.ts",
    "cf:typegen": "wrangler types functions/cloudflare-env.d.ts --config wrangler.jsonc --env-file .dev.vars.example --env-interface CloudflareEnv --include-runtime false --strict-vars false && npm --prefix cloudflare-cms run cf:typegen",
    "cf:preview": "npm run validate:cloudflare-config && npm run build && wrangler pages dev out --env-file .dev.vars.example",
    "cf:test-server": "wrangler pages dev out --binding IP_HASH_SALT=ci-only-not-a-production-secret-00000001 --binding ANALYTICS_HASH_SALT=ci-only-analytics-not-production-0000001 --persist-to cloudflare-cms/.wrangler/state --port 4173",
    "d1:migrate:local": "wrangler d1 migrations apply tung-phat-leads-preview --local --config cloudflare-cms/wrangler.jsonc --env preview",
    "d1:migrate:preview": "npm run validate:cloudflare-config && npm --prefix cloudflare-cms run d1:migrate:preview",
    "d1:migrate:remote": "npm run validate:cloudflare-config && npm --prefix cloudflare-cms run d1:migrate:production",
    "d1:backup": "npm run validate:cloudflare-config && npm --prefix cloudflare-cms run d1:backup",
    "cms:dev": "npm --prefix cloudflare-cms run dev",
    "cms:dry-run": "npm --prefix cloudflare-cms run cms:dry-run",
    "cms:deploy": "npm --prefix cloudflare-cms run deploy:production",
    "analytics:maintenance:dry-run": "wrangler deploy --dry-run --env=\"\" --config workers/analytics-maintenance/wrangler.jsonc",
    "analytics:maintenance:preview": "wrangler deploy --env preview --config workers/analytics-maintenance/wrangler.jsonc",
    "analytics:maintenance:deploy": "wrangler deploy --env=\"\" --config workers/analytics-maintenance/wrangler.jsonc",
    "catalog:ancuong:discover": "tsx scripts/ancuong/cli.ts discover",
    "catalog:ancuong:discover:documents": "tsx scripts/ancuong/cli.ts discover:documents",
    "catalog:ancuong:crawl:non-numeric": "tsx scripts/ancuong/cli.ts crawl:non-numeric",
    "catalog:ancuong:crawl:product-lines": "tsx scripts/ancuong/cli.ts crawl:product-lines",
    "catalog:ancuong:crawl:listings": "tsx scripts/ancuong/cli.ts crawl:listings",
    "catalog:ancuong:crawl:details": "tsx scripts/ancuong/cli.ts crawl:details",
    "catalog:ancuong:crawl:relations": "tsx scripts/ancuong/cli.ts crawl:relations",
    "catalog:ancuong:media": "tsx scripts/ancuong/cli.ts media",
    "catalog:ancuong:color-media:discover": "tsx scripts/ancuong/media-discover.ts",
    "catalog:ancuong:color-media:download": "tsx scripts/ancuong/media-download.ts && npm run media:publish",
    "catalog:ancuong:color-media:validate": "tsx scripts/ancuong/media-validate.ts",
    "catalog:ancuong:normalize": "tsx scripts/ancuong/cli.ts normalize",
    "catalog:ancuong:manifest": "tsx scripts/ancuong/cli.ts manifest",
    "catalog:ancuong:validate": "tsx scripts/ancuong/cli.ts validate",
    "catalog:ancuong:diff": "tsx scripts/ancuong/cli.ts diff",
    "catalog:ancuong:export": "tsx scripts/ancuong/cli.ts export",
    "catalog:ancuong:report": "tsx scripts/ancuong/cli.ts report",
    "catalog:ancuong:sample": "tsx scripts/ancuong/cli.ts sample",
    "catalog:ancuong:all": "tsx scripts/ancuong/cli.ts all",
    "catalog:ancuong:test:live": "tsx scripts/ancuong/cli.ts test:live",
    "catalog:suppliers:validate": "npm run catalog:thanh-thuy:validate && npm run catalog:ba-thanh:validate && npm run catalog:ancuong:validate",
    "catalog:suppliers:test": "vitest run supplier thanh-thuy ba-thanh ancuong",
    "catalog:suppliers:audit": "npm run catalog:thanh-thuy:audit-duplication && npm run catalog:ba-thanh:audit && npm run catalog:ancuong:report",
    "catalog:suppliers:audit:output": "tsx scripts/catalog-suppliers/output-audit.ts",
    "catalog:suppliers:media": "tsx scripts/catalog-suppliers/media-provenance.ts",
    "catalog:suppliers:media:offline": "tsx scripts/catalog-suppliers/media-provenance.ts --offline",
    "catalog:suppliers:media:validate": "tsx scripts/catalog-suppliers/media-provenance.ts --validate-only",
    "catalog:suppliers:search-index": "tsx scripts/catalog-suppliers/build-search-index.ts",
    "catalog:suppliers:color-codes": "tsx scripts/catalog-suppliers/build-color-code-index.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.24.0",
    "next": "15.5.21",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/workers-types": "^5.20260718.1",
    "@eslint/eslintrc": "^3.3.6",
    "@noble/hashes": "^2.2.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.21",
    "postcss": "^8.5.20",
    "serve": "^14.2.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=20.19 <27"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}

{
  "name": "tung-phat-landing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:content && npm run images:check && node ./node_modules/next/dist/bin/next build",
    "postbuild": "node scripts/clean-placeholder-routes.mjs",
    "start": "npx serve out",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.cloudflare.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --reporter=list",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:links": "node scripts/check-internal-links.mjs",
    "images:check": "node scripts/check-images.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "cf:typegen": "wrangler types functions/cloudflare-env.d.ts --config wrangler.jsonc --env-interface CloudflareEnv --include-runtime false --strict-vars false && wrangler types workers/cms-oauth/worker-configuration.d.ts --config workers/cms-oauth/wrangler.jsonc --env-interface Env --include-runtime false --strict-vars false",
    "cf:preview": "npm run build && wrangler pages dev out",
    "cf:test-server": "wrangler pages dev out --port 4173",
    "cf:deploy": "npm run build && wrangler pages deploy out --project-name tung-phat",
    "d1:migrate:local": "wrangler d1 migrations apply tung-phat-leads --local",
    "d1:migrate:preview": "wrangler d1 migrations apply tung-phat-leads-preview --remote --env preview",
    "d1:migrate:remote": "wrangler d1 migrations apply tung-phat-leads --remote",
    "d1:backup": "wrangler d1 export tung-phat-leads --remote --output backups/tung-phat-leads.sql",
    "cms:dev": "wrangler dev --config workers/cms-oauth/wrangler.jsonc",
    "cms:dry-run": "wrangler deploy --config workers/cms-oauth/wrangler.jsonc --dry-run",
    "cms:deploy": "wrangler deploy --config workers/cms-oauth/wrangler.jsonc"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.24.0",
    "next": "15.5.20",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/workers-types": "^5.20260716.1",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.5.6",
    "prettier": "^3.9.5",
    "serve": "^14.2.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.111.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=20.19 <27"
  }
}
